    <script>
        let appState = {
            balance: 3402,
            currentScreen: 'home',
            previousScreen: 'home',
            selectedTask: { title: '', desc: '', reward: 0 }
        };

        function updateBalanceUI() {
            document.getElementById('coinBalance').innerText = appState.balance.toLocaleString();
            if (document.getElementById('walletCoinVal')) {
                document.getElementById('walletCoinVal').innerText = appState.balance.toLocaleString();
            }
        }

        function showScreen(screenId) {
            appState.previousScreen = appState.currentScreen;
            appState.currentScreen = screenId;

            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));

            const target = document.getElementById('screen-' + screenId);
            if (target) target.classList.add('active');

            const activeNav = document.getElementById('nav-' + screenId);
            if (activeNav) activeNav.classList.add('active');

            const backBtn = document.getElementById('backBtn');
            const menuBtn = document.getElementById('menuBtn');

            if (screenId === 'home') {
                backBtn.style.display = 'none';
                menuBtn.style.display = 'inline-block';
            } else {
                backBtn.style.display = 'inline-block';
                menuBtn.style.display = 'none';
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function goBack() {
            showScreen('home');
        }

        function openTaskDetail(title, desc, reward) {
            appState.selectedTask = { title, desc, reward };
            document.getElementById('taskTitle').innerText = title;
            document.getElementById('taskSub').innerText = desc;
            document.getElementById('taskReward').innerText = '+' + reward;
            showScreen('task-detail');
        }

        function completeTaskAction() {
            claimCoins(appState.selectedTask.reward);
            showScreen('tasks');
        }

        function claimCoins(amount) {
            appState.balance += amount;
            updateBalanceUI();
            alert('Congratulations! +' + amount + ' Coins added to your account.');
        }

        function redeemCoins(minAmount, provider) {
            if (appState.balance >= minAmount) {
                appState.balance -= minAmount;
                updateBalanceUI();
                alert('Redeem request submitted successfully via ' + provider + '!');
            } else {
                alert('Insufficient balance! You need at least ' + minAmount + ' coins.');
            }
        }
    </script>
</body>
</html>
