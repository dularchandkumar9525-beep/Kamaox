    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background: #080413; color: white; display: flex; justify-content: center; min-height: 100vh; }
        .app-container { width: 100%; max-width: 480px; background: #0b061c; min-height: 100vh; padding-bottom: 75px; position: relative; }

        /* Header */
        header { padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; background: #0b061c; position: sticky; top:0; z-index:20; }
        .header-left { display: flex; align-items: center; gap: 10px; }
        .back-btn { font-size: 20px; cursor: pointer; display: none; }
        .menu-btn { font-size: 20px; cursor: pointer; }
        .logo { font-size: 20px; font-weight: 800; } .logo span { color: #8b5cf6; }
        .coin-badge { background: #ffffff; color: #000; padding: 4px 12px; border-radius: 20px; font-weight: bold; font-size: 13px; display: flex; align-items: center; gap: 4px; box-shadow: 0 2px 6px rgba(0,0,0,0.3); }

        /* Screens Layout */
        .screen { display: none; padding: 12px 16px; }
        .screen.active { display: block; }

        /* Hero Banner */
        .hero-banner { background: linear-gradient(135deg, #240c54, #0f0529); padding: 20px; border-radius: 16px; margin-bottom: 15px; border: 1px solid #2d186b; }
        .hero-banner h2 { font-size: 22px; line-height: 1.2; }
        .highlight { color: #f59e0b; }
        .hero-banner p { color: #9ca3af; font-size: 12px; margin: 8px 0 15px 0; }
        .auth-btns { display: flex; gap: 10px; }
        .btn { flex: 1; padding: 10px; border-radius: 8px; border: none; font-weight: bold; cursor: pointer; font-size: 14px; }
        .btn-purple { background: #6d28d9; color: white; }
        .btn-yellow { background: #f59e0b; color: black; }

        /* Section Title */
        .section-title { font-size: 15px; font-weight: bold; margin: 15px 0 10px 0; display: flex; justify-content: space-between; align-items: center; }
        .view-all { font-size: 12px; color: #9ca3af; cursor: pointer; }

        /* Quick Actions */
        .quick-actions { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 15px; }
        .action-item { background: #150d33; padding: 10px 4px; border-radius: 12px; text-align: center; font-size: 11px; cursor: pointer; border: 1px solid #23144f; }
        .action-icon { width: 38px; height: 38px; border-radius: 10px; margin: 0 auto 6px; display: flex; align-items: center; justify-content: center; font-size: 18px; }

        /* Colors */
        .bg-purple { background: #6d28d9; }
        .bg-green { background: #059669; }
        .bg-blue { background: #2563eb; }
        .bg-orange { background: #ea580c; }
        .bg-red { background: #dc2626; }
        .bg-teal { background: #0d9488; }
        .bg-pink { background: #db2777; }

        /* Cards & Lists */
        .list-container { display: flex; flex-direction: column; gap: 8px; }
        .list-card { background: #120a2e; padding: 12px; border-radius: 12px; border: 1px solid #221252; display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
        .card-info { display: flex; gap: 12px; align-items: center; }
        .card-img { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink:0; }
        .card-text h4 { font-size: 14px; margin-bottom: 2px; }
        .card-text p { font-size: 11px; color: #9ca3af; }
        .coin-reward { color: #f59e0b; font-weight: bold; font-size: 13px; }
        .card-right { display: flex; align-items: center; gap: 10px; }
        .btn-action { border: none; padding: 6px 14px; border-radius: 6px; font-weight: bold; font-size: 12px; cursor: pointer; color: white; }

        /* Screen Banners & Pills */
        .screen-header-banner { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        .banner-icon { font-size: 40px; }
        .filter-pills { display: flex; gap: 8px; margin-bottom: 15px; overflow-x: auto; padding-bottom: 4px; }
        .pill { background: #150d33; border: 1px solid #28175b; color: #9ca3af; padding: 6px 14px; border-radius: 20px; font-size: 12px; cursor: pointer; white-space: nowrap; }
        .pill.active { background: #6d28d9; color: white; border-color: #6d28d9; }

        /* Light Theme Container for Games & Wallet */
        .bg-white-card { background: #fdfdfd; padding: 12px; border-radius: 16px; gap: 10px; }
        .list-card-light { background: #f3f4f6; color: #111827; padding: 10px 12px; border-radius: 10px; display: flex; justify-content: space-between; align-items: center; }
        .list-card-light .card-text p { color: #6b7280; }

        /* Task Details Screen */
        .detail-card-main { background: #120a2e; border: 1px solid #27145e; border-radius: 14px; padding: 16px; margin-bottom: 15px; }
        .detail-header-info { display: flex; align-items: center; gap: 12px; position: relative; }
        .large-icon { width: 50px; height: 50px; font-size: 26px; }
        .detail-reward-badge { position: absolute; right: 0; color: #f59e0b; font-size: 20px; font-weight: bold; }
        .detail-section { background: #120a2e; border: 1px solid #27145e; border-radius: 14px; padding: 16px; margin-bottom: 15px; }
        .detail-section h4 { margin-bottom: 12px; font-size: 14px; color: #e5e7eb; }
        .step-item { display: flex; align-items: center; gap: 10px; font-size: 13px; margin-bottom: 10px; color: #d1d5db; }
        .step-num { background: #2a1563; color: #8b5cf6; width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: bold; }
        .bullet-list { margin-left: 18px; font-size: 12px; color: #9ca3af; line-height: 1.8; }
        .btn-large-purple { width: 100%; background: #5b21b6; color: white; padding: 14px; border: none; border-radius: 10px; font-size: 16px; font-weight: bold; cursor: pointer; margin-top: 10px; }

        /* Wallet Screen */
        .wallet-balance-card { background: linear-gradient(135deg, #4c1d95, #1e1b4b); padding: 16px; border-radius: 14px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        .sub-label { font-size: 11px; color: #c084fc; }
        .big-balance { font-size: 24px; font-weight: bold; margin-top: 2px; }
        .btn-trans-history { background: rgba(0,0,0,0.3); color: white; border: none; padding: 8px 12px; border-radius: 8px; font-size: 11px; cursor: pointer; }
        .pay-logo { font-weight: 900; font-style: italic; font-size: 16px; width: 45px; text-align: center; color: #000; }
        .blue-text { color: #00baf2; }
        .darkblue-text { color: #003087; }
        .play-logo { color: #ea4335; font-style: normal; font-size: 20px; }

        /* Bottom Nav */
        .bottom-nav { position: fixed; bottom: 0; width: 100%; max-width: 480px; background: #0b061c; border-top: 1px solid #1a0f3d; display: flex; justify-around; padding: 8px 0; z-index: 100; }
        .nav-item { display: flex; flex-direction: column; align-items: center; color: #6b7280; font-size: 10px; cursor: pointer; gap: 3px; }
        .nav-item.active { color: #a855f7; }
        .nav-icon { font-size: 18px; }
    </style>
</head>
